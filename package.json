{
  "name": "production-line-diary",
  "version": "0.1.0",
  "description": "產線工作日誌 — 設備異常紀錄與可視化儀表板",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/ensure-web-build.js && node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test:web": "vitest run --config web/vite.config.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node --check backend/server.js && node --check backend/lib/aggregate.js && node --check backend/lib/store.js && node --check backend/lib/xlsx.js && node --check backend/lib/migrateLogic.js && node --check backend/lib/photos.js && node --check backend/lib/photoCaptions.js && node --check backend/lib/validate.js && node --check scripts/migrate.js && node --check scripts/ensure-web-build.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-sans-tc": "5.3.0",
    "@fontsource/noto-serif-tc": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "1.48.0",
    "multer": "^2.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
